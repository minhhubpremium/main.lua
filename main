end
local function selectTab(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        b.BackgroundColor3 = (n == name) and GOLD or PANEL
        b.TextColor3 = (n == name) and Color3.fromRGB(20, 20, 20) or MUTED
    end
end
