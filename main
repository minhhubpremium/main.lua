local infoCard = card(pInfo, 120)
local info = label(infoCard, "Minh Hub - Paper to Plane\n\n• Đứng trong THROW ZONE để tự ném.\n• Nếu không trúng PERFECT: tăng 'Sai số' hoặc\n  chỉnh indicatorNames trong CFG (đầu file).\n• Tab Extra: Auto bay qua vòng vàng / Anti-AFK / Auto Rejoin.\n• Kéo thanh tiêu đề để di chuyển menu.", 11, Enum.Font.Gotham, Color3.new(1, 1, 1), UDim2.fromOffset(10, 6), UDim2.new(1, -20, 1, -12))
info.TextWrapped = true; info.TextYAlignment = Enum.TextYAlignment.Top

-- TAB EXTRA
newTab("Extra")
local pExtra = newPage("Extra")
addToggle(pExtra, "Auto bay qua vòng vàng", "Giữ A/D để xuyên qua tâm vòng khi máy bay đang bay", function() return CFG.autoSteer end, function(v) CFG.autoSteer = v end)
addToggle(pExtra, "Anti-AFK", "Chống bị kick vì đứng yên", function() return CFG.antiAfk end, function(v) CFG.antiAfk = v end)
addToggle(pExtra, "Auto Rejoin", "Tự vào lại khi bị disconnect / lỗi teleport", function() return CFG.autoRejoin end, function(v) CFG.autoRejoin = v end)
addSlider(pExtra, "Vùng chết lái (studs)", 0.5, 15, 0.5, function() return CFG.steerDead end, function(v) CFG.steerDead = v end, "%.1f")
addSlider(pExtra, "Nhịp zigzag khi không thấy vòng (s)", 0.15, 1, 0.05, function() return CFG.steerInterval end, function(v) CFG.steerInterval = v end, "%.2f")

selectTab("Main")

-- cập nhật trạng thái
task.spawn(function()
    while alive do
        task.wait(0.2)
        statusText.Text = STATUS
        countText.Text = "Đã ném: " .. tostring(CFG.count or 0) .. "  |  Đã gấp: " .. tostring(CFG.folds or 0) .. "  |  Rebirth: " .. tostring(CFG.rebirths or 0)
    end
end)

-- ẩn/hiện, thu nhỏ, đóng
local userHidden = false
local function setVisible(v) userHidden = not v; main.Visible = v end
openBtn.MouseButton1Click:Connect(function() setVisible(not main.Visible) end)
minBtn.MouseButton1Click:Connect(function() setVisible(false) end)
closeBtn.MouseButton1Click:Connect(function() if _G.MinhAutoThrowStop then _G.MinhAutoThrowStop() end end)
UserInputService.InputBegan:Connect(function(i, gp)
    if not gp and i.KeyCode == Enum.KeyCode.RightShift then setVisible(not main.Visible) end
end)

-- kéo menu bằng header (và nút M)
local function makeDraggable(handle, target)
    local dragging, startPos, startFrame
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startFrame = true, i.Position, target.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startPos
            target.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end
makeDraggable(header, main)

_G.MinhAutoThrowStop = function()
    alive = false
    pcall(function() holdKey(nil) end)
    pcall(function() gui:Destroy() end)
end
log("Đã chạy. Đứng trong THROW ZONE để tự ném. RightShift = ẩn/hiện menu.")
