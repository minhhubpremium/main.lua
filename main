local function addToggle(page, text, desc, get, set)
    local c = card(page, 46)
    label(c, text, 13, Enum.Font.GothamBold, Color3.new(1, 1, 1), UDim2.fromOffset(10, 4), UDim2.new(1, -70, 0, 20))
    label(c, desc, 10, Enum.Font.Gotham, MUTED, UDim2.fromOffset(10, 24), UDim2.new(1, -70, 0, 16))
    local sw = Instance.new("TextButton")
    sw.Size = UDim2.fromOffset(46, 24); sw.Position = UDim2.new(1, -56, 0.5, -12); sw.Text = ""; sw.AutoButtonColor = false; sw.Parent = c
    corner(sw, 12)
    local knob = Instance.new("Frame"); knob.Size = UDim2.fromOffset(18, 18); knob.BackgroundColor3 = Color3.new(1, 1, 1); knob.Parent = sw; corner(knob, 9)
    local function paint()
        local on = get()
        sw.BackgroundColor3 = on and GOLD or Color3.fromRGB(70, 70, 80)
        knob.Position = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
    end
    paint()
    sw.MouseButton1Click:Connect(function() set(not get()); paint() end)
    return paint
end

local function addSlider(page, text, min, max, step, get, set, fmt)
    local c = card(page, 54)
    label(c, text, 12, Enum.Font.GothamBold, Color3.new(1, 1, 1), UDim2.fromOffset(10, 4), UDim2.new(1, -80, 0, 20))
    local val = label(c, "", 12, Enum.Font.GothamBold, GOLD, UDim2.new(1, -70, 0, 4), UDim2.fromOffset(60, 20), Enum.TextXAlignment.Right)
    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, -20, 0, 8); track.Position = UDim2.new(0, 10, 1, -16); track.Text = ""; track.AutoButtonColor = false
    track.BackgroundColor3 = Color3.fromRGB(14, 14, 18); track.BorderSizePixel = 0; track.Parent = c; corner(track, 4)
    local fill = Instance.new("Frame"); fill.BackgroundColor3 = GOLD; fill.BorderSizePixel = 0; fill.Parent = track; corner(fill, 4)
    local function paint()
        local v = get()
        fill.Size = UDim2.new(math.clamp((v - min) / (max - min), 0, 1), 0, 1, 0)
        val.Text = string.format(fmt or "%.2f", v)
    end
    paint()
    local dragging = false
    local function fromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local t = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        local v = min + t * (max - min)
        v = math.floor(v / step + 0.5) * step
        set(math.clamp(v, min, max)); paint()
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; fromX(i.Position.X) end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

