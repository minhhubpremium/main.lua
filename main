--[[
    MINH HUB - PAPER TO PLANE : AUTO THROW (tự động ném máy bay)
    Viết theo video bạn gửi (nút THROW -> thanh canh nhịp PERFECT -> nút THROW!).
    CHƯA kiểm chứng trong game (không có quyền chạy Roblox): script tìm nút/thanh trên giao diện theo TÊN CHỮ,
    nên nếu game đặt tên khác thì chỉnh bảng CFG bên dưới. Có in log [AutoThrow] ở console (F9) để dễ chỉnh.

    Cách dùng: execute script -> menu "Minh Hub" (nút M để ẩn/hiện, kéo thanh tiêu đề để di chuyển).
    Đứng trong THROW ZONE là script tự bấm THROW, chờ thanh canh nhịp tới vùng PERFECT rồi bấm THROW! lần 2.
]]

if _G.MinhAutoThrowStop then pcall(_G.MinhAutoThrowStop) end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer
local okVIM, VIM = pcall(function() return game:GetService("VirtualInputManager") end)

local CFG = {
    enabled        = true,
    scanInterval   = 0.12,          -- giây giữa 2 lần quét giao diện
    throwWords     = {"throw"},     -- chữ trên nút (không phân biệt hoa thường, bỏ dấu !)
    perfectWords   = {"perfect"},   -- nhãn vùng PERFECT trên thanh canh nhịp
    indicatorNames = {"indicator", "marker", "pointer", "cursor", "needle", "slider", "arrow", "bar"},
    perfectTolerance = 0.045,       -- sai số cho phép = % chiều rộng thanh quanh tâm PERFECT
    cooldown       = 0.8,           -- tối thiểu giữa 2 lần bấm nút
    maxWaitBar     = 3.0,           -- chờ thanh canh nhịp tối đa (s) rồi bấm luôn nếu không bắt được chỉ báo
    debug          = true,
}
local STATUS = "Chờ vào THROW ZONE..."

local alive = true
local lastClickAt = 0
local state = { phase = "idle", since = 0 }

local function log(...)
    if CFG.debug then print("[AutoThrow]", ...) end
end

local function lowerText(o)
    local ok, t = pcall(function() return o.Text end)
    return ok and string.lower(tostring(t or "")) or ""
end

local function normWord(t)
    return (string.gsub(string.gsub(t, "[^%a]", ""), "%s+", ""))
end

local function hasWord(text, words)
    local n = normWord(text)
    for _, w in ipairs(words) do
        if n == w then return true end
    end
    return false
end

local function isShown(obj)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local cur = obj
    while cur and cur ~= pg and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

-- Tìm nút THROW đang hiện: TextButton có chữ "THROW"/"THROW!" hoặc nút có TextLabel con với chữ đó.
local function findThrowButton()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("TextLabel")) and d.Text ~= "" and hasWord(lowerText(d), CFG.throwWords) and isShown(d) then
            -- ưu tiên chính nút; nếu là nhãn thì lấy nút cha gần nhất (hoặc chính nhãn)
            local btn = d
            if d:IsA("TextLabel") then
                local p = d.Parent
                for _ = 1, 4 do
                    if p and (p:IsA("TextButton") or p:IsA("ImageButton")) then btn = p break end
                    p = p and p.Parent
                end
            end
            -- loại chữ "THROW ZONE" (không phải nút): hasWord yêu cầu khớp CẢ chuỗi nên đã loại.
            return btn, d
        end
    end
    return nil
end

local function exclaim(label)
    return label and string.find(lowerText(label), "!", 1, true) ~= nil
end

-- Tìm vùng PERFECT + chỉ báo di chuyển trên thanh canh nhịp.
local function findBar()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" and hasWord(lowerText(d), CFG.perfectWords) and isShown(d) then
            -- thanh = tổ tiên chứa nhãn PERFECT và có chiều rộng lớn
            local bar = d.Parent
            for _ = 1, 3 do
                if bar and bar:IsA("GuiObject") and bar.AbsoluteSize.X > 150 then break end
                bar = bar and bar.Parent
            end
            if bar and bar:IsA("GuiObject") then
                return bar, d
            end
        end
    end
    return nil
end

local function findIndicator(bar, perfectLabel)
    local best
    for _, d in ipairs(bar:GetDescendants()) do
        if d:IsA("GuiObject") and d ~= perfectLabel and d.Visible and not d:IsA("TextLabel") then
            local n = string.lower(d.Name)
            for _, key in ipairs(CFG.indicatorNames) do
                if string.find(n, key, 1, true) and d.AbsoluteSize.X < bar.AbsoluteSize.X * 0.2 then
                    best = d
                    break
                end
            end
            if best then break end
        end
    end
    return best
end

-- Bấm nút: ưu tiên kích hoạt trực tiếp sự kiện của nút, dự phòng click ảo lên màn hình.
-- mode: nil = kích hoạt sự kiện nút + click ảo (có bù GuiInset đúng theo ScreenGui);
--       "noinset" = click ảo không bù inset; "click" = chỉ click ảo; "signal" = chỉ kích hoạt sự kiện nút
local function pressButton(btn, mode)
    if not btn or not btn.Parent then return false end
    local fired = false
    if mode ~= "noinset" and mode ~= "click" then
        -- kích hoạt sự kiện trên chính nút và các nút/khung con (nhiều game gắn handler vào nút con)
        local targets = { btn }
        for _, c in ipairs(btn:GetDescendants()) do
            if c:IsA("GuiButton") then targets[#targets + 1] = c end
        end
        if typeof(getconnections) == "function" then
            for _, t in ipairs(targets) do
                for _, sigName in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
                    local okS, sig = pcall(function() return t:IsA("GuiButton") and t[sigName] end)
                    if okS and sig then
                        local okC, conns = pcall(getconnections, sig)
                        if okC and conns then
                            for _, c in ipairs(conns) do
                                if pcall(function() c:Fire() end) then fired = true end
                            end
                        end
                    end
                end
            end
        end
        if not fired and typeof(firesignal) == "function" and btn:IsA("GuiButton") then
            if pcall(firesignal, btn.MouseButton1Click) then fired = true end
            pcall(firesignal, btn.Activated)
        end
    end
    if mode ~= "signal" and okVIM and VIM then
        local pos, size = btn.AbsolutePosition, btn.AbsoluteSize
        local inset = 0
        if mode ~= "noinset" then
            local sg = btn:FindFirstAncestorOfClass("ScreenGui")
            if not (sg and sg.IgnoreGuiInset) then inset = GuiService:GetGuiInset().Y end
        end
        local x, y = pos.X + size.X / 2, pos.Y + size.Y / 2 + inset
        pcall(function()
            VIM:SendMouseMoveEvent(x, y, game)
            task.wait(0.03)
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end)
        fired = true
    end
    return fired
end

-- VÒNG LẶP CHÍNH
task.spawn(function()
    while alive do
        task.wait(CFG.scanInterval)
        if not CFG.enabled then state.phase = "idle" continue end
        local ok, err = pcall(function()
            local btn, label = findThrowButton()
            if not btn then state.phase = "idle"; STATUS = "Chờ vào THROW ZONE..." return end
            if tick() - lastClickAt < CFG.cooldown then return end

            local bar, perfectLabel = findBar()
            if bar and perfectLabel then
                -- Thanh canh nhịp đang chạy: chờ chỉ báo vào vùng PERFECT rồi bấm THROW!
                if state.phase ~= "bar" then state.phase = "bar"; state.since = tick(); log("Thanh canh nhịp xuất hiện") end
                STATUS = "Đang canh nhịp PERFECT..."
                local ind = findIndicator(bar, perfectLabel)
                local centerX = perfectLabel.AbsolutePosition.X + perfectLabel.AbsoluteSize.X / 2
                local tol = bar.AbsoluteSize.X * CFG.perfectTolerance
                local inZone = false
                if ind then
                    local ix = ind.AbsolutePosition.X + ind.AbsoluteSize.X / 2
                    inZone = math.abs(ix - centerX) <= tol
                end
                if inZone or tick() - state.since > CFG.maxWaitBar then
                    log(inZone and "PERFECT -> THROW!" or "Không bắt được chỉ báo -> THROW! luôn")
                    lastClickAt = tick()
                    pressButton(btn)
                    state.phase = "thrown"
                    CFG.count = (CFG.count or 0) + 1
                    STATUS = "Đã ném lần " .. CFG.count
                end
            else
                -- Chưa có thanh: bấm THROW để bắt đầu lượt ném
                log("Bấm THROW")
                STATUS = "Đã bấm THROW"
                lastClickAt = tick()
                pressButton(btn)
                state.phase = "started"
                state.since = tick()
            end
        end)
        if not ok then log("Lỗi vòng lặp:", tostring(err)) end
    end
end)

-- ============================================================
-- AUTO GẤP GIẤY + TỰ ĐI TỚI THROW ZONE
-- (đoán theo tên/chữ vì không có mã nguồn game: nút/prompt chứa chữ "fold", part tên chứa "throwzone")
-- Nếu game đặt tên khác: đứng ở THROW ZONE bấm "Lưu vị trí THROW ZONE" trong menu (tab Main).
-- ============================================================
local TweenService = game:GetService("TweenService")
CFG.autoFold      = false
CFG.autoZone      = false
CFG.foldWords     = {"fold"}                      -- chữ trên nút / ProximityPrompt gấp giấy
CFG.zoneNames     = {"throwzone", "throwarea", "launchzone", "launchpad"}   -- tên part (bỏ khoảng trắng/_)
CFG.foldsPerThrow = 1                             -- gấp mấy lần trước khi đi ném
CFG.foldInterval  = 0.45
CFG.zoneSpeed     = 120                           -- studs/giây khi di chuyển tới zone
CFG.zonePos       = nil                           -- Vector3, đặt bằng nút "Lưu vị trí THROW ZONE"
CFG.foldPos       = nil                           -- Vector3, nơi gấp giấy (nếu cần đứng gần), nút "Lưu vị trí gấp giấy"

local foldsDone, lastFoldAt, lastMoveAt = 0, 0, 0
local lastThrowCount = 0

local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

local function isFlying()
    -- khi máy bay đang bay game hiện "A / D to steer!"
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" and string.find(lowerText(d), "to steer", 1, true) and isShown(d) then
            return true
        end
    end
    return false
end

local zoneCache = { at = -100, part = nil }
local function findZonePart()
    if tick() - zoneCache.at < 5 and (not zoneCache.part or zoneCache.part.Parent) then return zoneCache.part end
    zoneCache.at = tick(); zoneCache.part = nil
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = string.gsub(string.lower(d.Name), "[^%a]", "")
            for _, key in ipairs(CFG.zoneNames) do
                if string.find(n, key, 1, true) then zoneCache.part = d break end
            end
            if zoneCache.part then break end
        end
    end
    return zoneCache.part
end

local function zoneTarget()
    local p = findZonePart()
    if p then return p.Position, p end
    return CFG.zonePos, nil
end

local function inZone(root)
    local pos, part = zoneTarget()
    if not pos then return true end   -- không biết zone ở đâu thì coi như đang ở đúng chỗ (tránh đi lung tung)
    if part then
        local rel = part.CFrame:PointToObjectSpace(root.Position)
        return math.abs(rel.X) <= part.Size.X / 2 + 2 and math.abs(rel.Z) <= part.Size.Z / 2 + 2
    end
    return (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude <= 10
end

local function moveTo(target)
    local root, hum = getRoot()
    if not root or not hum or hum.Health <= 0 then return end
    if tick() - lastMoveAt < 1.2 then return end
    lastMoveAt = tick()
    local dest = target + Vector3.new(0, 3, 0)
    local dist = (root.Position - dest).Magnitude
    if dist > 25 then
        local tw = TweenService:Create(root, TweenInfo.new(math.max(dist / CFG.zoneSpeed, 0.2), Enum.EasingStyle.Linear), {CFrame = CFrame.new(dest)})
        tw:Play()
        local t0 = tick()
        while tw.PlaybackState == Enum.PlaybackState.Playing and tick() - t0 < dist / CFG.zoneSpeed + 2 and alive do
            if not (CFG.autoZone or CFG.autoFold) then tw:Cancel() break end
            task.wait(0.1)
        end
    else
        hum:MoveTo(dest)
    end
end

-- Tìm cách gấp giấy: nút GUI chứa chữ "fold" (không phải nhãn "0 FOLDS"), hoặc ProximityPrompt "fold".
local function findFoldAction()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and isShown(d) then
                local txt = d:IsA("TextButton") and lowerText(d) or ""
                if txt == "" then
                    for _, c in ipairs(d:GetDescendants()) do
                        if c:IsA("TextLabel") then txt = lowerText(c) break end
                    end
                end
                local n = normWord(txt)
                if n ~= "" and string.find(n, "fold", 1, true) and not string.find(n, "folds", 1, true) then
                    return "gui", d
                end
            end
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            local t = string.lower((d.ActionText or "") .. " " .. (d.ObjectText or ""))
            if string.find(t, "fold", 1, true) then return "prompt", d end
        end
    end
    return nil
end

local function doFold()
    local kind, obj = findFoldAction()
    if not kind then
        if CFG.foldPos then moveTo(CFG.foldPos) end
        return false
    end
    if kind == "gui" then
        pressButton(obj)
    else
        local root = getRoot()
        local pp = obj.Parent
        local pos = pp and (pp:IsA("BasePart") and pp.Position or (pp:IsA("Attachment") and pp.WorldPosition))
        if root and pos and (root.Position - pos).Magnitude > (obj.MaxActivationDistance or 10) - 1 then
            moveTo(pos)
        end
        if typeof(fireproximityprompt) == "function" then pcall(fireproximityprompt, obj) end
    end
    foldsDone = foldsDone + 1
    CFG.folds = (CFG.folds or 0) + 1
    STATUS = "Đã gấp giấy (" .. CFG.folds .. ")"
    log("Gấp giấy", kind)
    return true
end

task.spawn(function()
    while alive do
        task.wait(0.35)
        if not (CFG.autoFold or CFG.autoZone) then continue end
        pcall(function()
            if (CFG.count or 0) ~= lastThrowCount then lastThrowCount = CFG.count or 0; foldsDone = 0 end
            if isFlying() then STATUS = "Máy bay đang bay..." return end
            local root, hum = getRoot()
            if not root or not hum or hum.Health <= 0 then return end
            local throwBtn = findThrowButton()
            if throwBtn then return end            -- đang ở THROW ZONE: vòng Auto Throw lo
            -- 1) gấp giấy trước
            if CFG.autoFold and foldsDone < CFG.foldsPerThrow and tick() - lastFoldAt >= CFG.foldInterval then
                lastFoldAt = tick()
                if doFold() then return end
            end
            -- 2) đủ giấy (hoặc không có gì để gấp) -> đi tới THROW ZONE
            if CFG.autoZone then
                local pos = zoneTarget()
                if not pos then STATUS = "Chưa biết vị trí THROW ZONE (bấm Lưu vị trí)"; return end
                if not inZone(root) then
                    STATUS = "Đang đi tới THROW ZONE..."
                    log("Đi tới THROW ZONE")
                    moveTo(pos)
                end
            end
        end)
    end
end)

-- ============================================================
-- AUTO REBIRTH (tự động tái sinh)
-- Tìm nút "Rebirth" trên giao diện (kèm % tiến độ). Đủ 100% thì bấm, rồi bấm nút xác nhận nếu hiện bảng.
-- Dự phòng: nếu không thấy nút nào, thử RemoteEvent/RemoteFunction có tên chứa "rebirth" (CFG.rebirthRemote).
-- ============================================================
CFG.autoRebirth   = false
CFG.rebirthRemote = false   -- đã biết giao diện thật nên mặc định tắt remote đoán mò
CFG.rebirthInterval = 3
CFG.rebirths = 0
local lastRebirthAt = 0

local function guiProgress(btn)
    -- tìm "xx%" trong nút hoặc khung cha gần nhất
    local scope = btn
    for _ = 1, 3 do
        for _, d in ipairs(scope:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" then
                local p = string.match(d.Text, "(%d+%.?%d*)%s*%%")
                if p then return tonumber(p) end
            end
        end
        scope = scope.Parent
        if not scope or scope:IsA("ScreenGui") then break end
    end
    return nil
end

local function findRebirthButtons()
    local list = {}
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return list end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and isShown(d) then
            local txt = d:IsA("TextButton") and lowerText(d) or ""
            if txt == "" then
                for _, c in ipairs(d:GetDescendants()) do
                    if c:IsA("TextLabel") and c.Text ~= "" then txt = lowerText(c) break end
                end
            end
            local n = normWord(txt)
            if n ~= "" and string.find(n, "rebirth", 1, true) and not string.find(n, "skip", 1, true) then list[#list + 1] = d end
        end
    end
    return list
end

local function findConfirmButton()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and isShown(d) then
            local txt = d:IsA("TextButton") and lowerText(d) or ""
            if txt == "" then
                for _, c in ipairs(d:GetDescendants()) do
                    if c:IsA("TextLabel") and c.Text ~= "" then txt = lowerText(c) break end
                end
            end
            local n = normWord(txt)
            if (n == "yes" or n == "confirm" or n == "ok" or n == "rebirthnow" or n == "confirmrebirth") and not string.find(n, "skip", 1, true) then return d end
        end
    end
    return nil
end

local function tryRebirthRemote()
    local RS = game:GetService("ReplicatedStorage")
    local fired = 0
    for _, d in ipairs(RS:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and string.find(string.lower(d.Name), "rebirth", 1, true) then
            local okF = pcall(function()
                if d:IsA("RemoteEvent") then d:FireServer() else d:InvokeServer() end
            end)
            if okF then fired = fired + 1; log("Rebirth remote:", d:GetFullName()) end
        end
    end
    return fired > 0
end

-- Bảng Rebirth (theo video): tiêu đề "Rebirth", Before/After, thanh "Level 45 / Level 45", nút xanh "Rebirth",
-- nút tím "Skip Rebirth" (tốn Robux - TUYỆT ĐỐI KHÔNG bấm), nút X đóng.
local function btnText(d)
    local txt = d:IsA("TextButton") and lowerText(d) or ""
    if txt == "" then
        for _, c in ipairs(d:GetDescendants()) do
            if c:IsA("TextLabel") and c.Text ~= "" then txt = lowerText(c) break end
        end
    end
    return normWord(txt)
end

local function findRebirthPanel()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and isShown(d) and btnText(d) == "skiprebirth" then
            -- panel = tổ tiên chứa cả nút Rebirth xanh
            local scope = d.Parent
            for _ = 1, 4 do
                if not scope then break end
                local go, close, lvA, lvB
                for _, c in ipairs(scope:GetDescendants()) do
                    if (c:IsA("TextButton") or c:IsA("ImageButton")) and isShown(c) then
                        local n = btnText(c)
                        if n == "rebirth" then go = c end
                        if n == "x" or n == "close" or n == "" and string.find(string.lower(c.Name), "close", 1, true) then close = close or c end
                    elseif c:IsA("TextLabel") and isShown(c) then
                        local a, b2 = string.match(c.Text, "[Ll]evel%s*(%d+)%s*/%s*[Ll]evel%s*(%d+)")
                        if a then lvA, lvB = tonumber(a), tonumber(b2) end
                    end
                end
                if go then return { go = go, close = close, lvA = lvA, lvB = lvB, skip = d } end
                scope = scope.Parent
            end
        end
    end
    return nil
end

task.spawn(function()
    while alive do
        task.wait(0.8)
        if not CFG.autoRebirth then continue end
        if tick() - lastRebirthAt < CFG.rebirthInterval then continue end
        pcall(function()
            -- 1) Bảng Rebirth đang mở
            local panel = findRebirthPanel()
            if panel then
                local ready = (panel.lvA == nil or panel.lvB == nil) or panel.lvA >= panel.lvB
                if ready then
                    lastRebirthAt = tick()
                    STATUS = "Đang tái sinh (Rebirth)..."
                    log("Bấm nút Rebirth trong bảng", panel.lvA and (panel.lvA .. "/" .. panel.lvB) or "")
                    -- Thử lần lượt nhiều kiểu bấm; sau mỗi lần kiểm tra bảng đã đóng / level đã reset chưa.
                    local modes = { nil, "noinset", "click", "signal" }
                    local done = false
                    for i = 1, 4 do
                        local p2 = findRebirthPanel()
                        if not p2 then done = true break end
                        if p2.lvA and p2.lvB and p2.lvA < p2.lvB then done = true break end   -- level đã về lại -> thành công
                        log("Rebirth: thử kiểu bấm #" .. i, tostring(modes[i]))
                        pressButton(p2.go, modes[i])
                        task.wait(1.0)
                    end
                    local after = findRebirthPanel()
                    if done or not after then
                        CFG.rebirths = CFG.rebirths + 1
                        STATUS = "Đã tái sinh xong"
                        log("Rebirth thành công")
                    else
                        STATUS = "Rebirth: bấm không ăn - xem log"
                        log("Rebirth: cả 4 kiểu bấm đều không đóng/reset bảng; đóng bảng và thử lại sau")
                        if after.close then pressButton(after.close) end
                        lastRebirthAt = tick() + 10
                    end
                else
                    STATUS = "Rebirth: chưa đủ level (" .. tostring(panel.lvA) .. "/" .. tostring(panel.lvB) .. ")"
                    if panel.close then pressButton(panel.close) end
                    lastRebirthAt = tick() + 5
                end
                return
            end
            -- 2) Chưa mở bảng: bấm nút Rebirth bên trái khi đủ 100%
            local btns = findRebirthButtons()
            if #btns > 0 then
                local target
                for _, b in ipairs(btns) do
                    local pr = guiProgress(b)
                    if pr and pr >= 100 then target = b break end
                end
                if target then
                    lastRebirthAt = tick() - CFG.rebirthInterval + 1.5   -- lượt kế tiếp (bảng) sau ~1.5s
                    STATUS = "Mở bảng Rebirth (100%)"
                    log("Bấm nút Rebirth bên trái (100%)")
                    pressButton(target)
                else
                    local pr = guiProgress(btns[1])
                    STATUS = "Rebirth: " .. (pr and (pr .. "%") or "chưa đọc được %")
                end
            elseif CFG.rebirthRemote then
                lastRebirthAt = tick()
                if tryRebirthRemote() then
                    CFG.rebirths = CFG.rebirths + 1
                    STATUS = "Rebirth qua remote"
                end
            end
        end)
    end
end)

-- ============================================================
-- TÍNH NĂNG BỔ SUNG: Anti-AFK, Auto Rejoin, Auto bay qua vòng vàng
-- Tất cả tìm nút theo CHỮ trên giao diện (không có mã nguồn game) nên cần thử và gửi log nếu không ăn.
-- Chữ chứa từ khóa bị loại (robux, r$, premium, gamepass, pack, skip...) sẽ không bao giờ được bấm để tránh tốn tiền thật.
-- ============================================================
CFG.antiAfk     = true
CFG.autoRejoin  = true
CFG.autoSteer   = false
CFG.steerInterval = 0.35

-- AUTO STEER QUA VÒNG VÀNG: khi game hiện "A/D to steer through the gold rings!", tìm vòng (part/model tên chứa "ring")
-- phía trước, tính độ lệch ngang giữa máy bay và vòng gần nhất rồi giữ A/D để bay xuyên qua tâm vòng.
-- Không tìm thấy vòng nào thì zigzag nhẹ như bản cũ (CFG.steerFallback).
CFG.steerDead     = 3        -- vùng chết (studs): lệch nhỏ hơn thì thả phím
CFG.steerRange    = 500      -- chỉ xét vòng trong tầm này phía trước
CFG.steerFallback = true
CFG.ringNames     = {"ring", "hoop"}
CFG.ringExclude   = {"spring", "string", "bring", "ringer", "earring", "ringing", "steering", "offering"}
CFG.rings         = 0

local ringCache = { at = -100, list = {}, mode = "none" }
local function ringPos(o)
    if o:IsA("BasePart") then return o.Position end
    if o:IsA("Model") then local ok, cf = pcall(function() return o:GetPivot() end) return ok and cf.Position or nil end
end

-- vòng vàng theo MÀU/VẬT LIỆU khi tên không khớp: part neon vàng, to, không va chạm
local function looksGold(d)
    if not d:IsA("BasePart") or d.Transparency > 0.92 then return false end
    local c = d.Color
    local gold = c.R > 0.8 and c.G > 0.65 and c.B < 0.55
    local biggest = math.max(d.Size.X, d.Size.Y, d.Size.Z)
    return gold and biggest >= 6 and (d.Material == Enum.Material.Neon or not d.CanCollide)
end

local function scanRings()
    if tick() - ringCache.at < 0.6 then return ringCache.list end
    ringCache.at = tick()
    local named, colored = {}, {}
    local cam = workspace.CurrentCamera
    local camPos = cam and cam.CFrame.Position
    local myChar = LocalPlayer.Character
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Model")) and not (myChar and d:IsDescendantOf(myChar)) then
            local p
            local n = string.gsub(string.lower(d.Name), "[^%a]", "")
            local hit = false
            for _, k in ipairs(CFG.ringNames) do if string.find(n, k, 1, true) then hit = true break end end
            if hit then
                for _, x in ipairs(CFG.ringExclude) do if string.find(n, x, 1, true) then hit = false break end end
            end
            if hit then
                p = ringPos(d)
                if p and camPos and (p - camPos).Magnitude < CFG.steerRange * 1.5 then named[#named + 1] = p end
            elseif #named == 0 and looksGold(d) then
                p = d.Position
                if camPos and (p - camPos).Magnitude < CFG.steerRange * 1.5 then colored[#colored + 1] = p end
            end
        end
    end
    local mode = (#named > 0) and "tên" or ((#colored > 0) and "màu vàng" or "none")
    if mode ~= ringCache.mode then
        ringCache.mode = mode
        log("Dò vòng theo:", mode, "| số vòng:", #named + #colored)
    end
    ringCache.list = (#named > 0) and named or colored
    return ringCache.list
end

-- vị trí máy bay: ưu tiên model/part tên "plane/paper/glider" gần camera (máy bay là vật mà camera bám theo),
-- nếu không thấy thì dùng chính camera (camera bay ngay sau máy bay nên độ lệch ngang gần như 0).
-- KHÔNG dùng HumanoidRootPart nhân vật: lúc máy bay bay, nhân vật có thể đang đứng yên ở THROW ZONE.
local planeCache = { at = -100, obj = nil }
local function planePos()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local camPos = cam.CFrame.Position
    local subj = cam.CameraSubject
    if subj and subj:IsA("BasePart") then return subj.Position end
    if tick() - planeCache.at > 1 or (planeCache.obj and not planeCache.obj.Parent) then
        planeCache.at = tick(); planeCache.obj = nil
        local best, bestD = nil, 90
        local myChar = LocalPlayer.Character
        for _, d in ipairs(workspace:GetDescendants()) do
            if (d:IsA("Model") or d:IsA("BasePart")) and not (myChar and d:IsDescendantOf(myChar)) then
                local n = string.lower(d.Name)
                if string.find(n, "plane", 1, true) or string.find(n, "paper", 1, true) or string.find(n, "glider", 1, true) then
                    local p = ringPos(d)
                    if p then
                        local dd = (p - camPos).Magnitude
                        if dd < bestD and dd > 2 then best, bestD = d, dd end
                    end
                end
            end
        end
        planeCache.obj = best
    end
    if planeCache.obj then
        local p = ringPos(planeCache.obj)
        if p then return p end
    end
    return camPos + cam.CFrame.LookVector * 20
end

local heldKey = nil
local function holdKey(key)
    if heldKey == key then return end
    if heldKey then pcall(function() VIM:SendKeyEvent(false, heldKey, false, game) end) end
    heldKey = key
    if key then pcall(function() VIM:SendKeyEvent(true, key, false, game) end) end
end

task.spawn(function()
    local zig = true
    local lastZig = 0
    while alive do
        task.wait(0.05)
        if not (CFG.autoSteer and okVIM and VIM) then holdKey(nil) continue end
        local okF, flying = pcall(isFlying)
        if not (okF and flying) then holdKey(nil) continue end
        pcall(function()
            local cam = workspace.CurrentCamera
            local me = planePos()
            if not cam or not me then holdKey(nil) return end
            local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.01 then flat = look end
            flat = flat.Unit
            local rightFlat = Vector3.new(right.X, 0, right.Z)
            rightFlat = rightFlat.Magnitude > 0.01 and rightFlat.Unit or right
            -- vòng gần nhất phía trước
            local best, bestAhead
            for _, p in ipairs(scanRings()) do
                local rel = p - me
                local ahead = rel:Dot(flat)
                if ahead > 4 and ahead < CFG.steerRange and (not bestAhead or ahead < bestAhead) then best, bestAhead = p, ahead end
            end
            if best then
                local err = (best - me):Dot(rightFlat)       -- >0: vòng ở bên phải
                if math.abs(err) <= CFG.steerDead then holdKey(nil)
                elseif err > 0 then holdKey(Enum.KeyCode.D)
                else holdKey(Enum.KeyCode.A) end
                STATUS = string.format("Bay qua vòng (%s): lệch %.0f, cách %.0f", ringCache.mode, err, bestAhead)
            elseif CFG.steerFallback then
                STATUS = "Không thấy vòng - zigzag nhẹ (xem log [AutoThrow])"
                -- không thấy vòng: zigzag nhẹ
                if tick() - lastZig >= CFG.steerInterval then
                    lastZig = tick(); zig = not zig
                    holdKey(zig and Enum.KeyCode.A or Enum.KeyCode.D)
                end
            else
                holdKey(nil)
            end
        end)
    end
end)

-- Anti-AFK
do
    local okVU, VU = pcall(function() return game:GetService("VirtualUser") end)
    LocalPlayer.Idled:Connect(function()
        if CFG.antiAfk and okVU and VU then
            pcall(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)
        end
    end)
end

-- Auto Rejoin: bị kick/disconnect/lỗi teleport thì vào lại
do
    local busy, tries = false, 0
    local TS = game:GetService("TeleportService")
    local function rejoin(reason, fresh)
        if not CFG.autoRejoin or busy then return end
        busy = true; tries = tries + 1
        log("Auto Rejoin:", tostring(reason))
        task.wait(2)
        pcall(function()
            local q = queue_on_teleport or (syn and syn.queue_on_teleport)
            local src = _G.MinhHubSource
            if q and type(src) == "string" and src ~= "" then q(src) end
        end)
        local ok = pcall(function()
            if not fresh and tries <= 1 and #Players:GetPlayers() > 1 then
                TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            else
                TS:Teleport(game.PlaceId, LocalPlayer)
            end
        end)
        if not ok then pcall(function() TS:Teleport(game.PlaceId, LocalPlayer) end) end
        task.wait(12); busy = false
    end
    pcall(function()
        GuiService.ErrorMessageChanged:Connect(function(msg)
            if msg and msg ~= "" then task.spawn(rejoin, "ErrorMessage: " .. tostring(msg)) end
        end)
    end)
    pcall(function()
        TS.TeleportInitFailed:Connect(function(_, result, msg)
            busy = false
            task.spawn(rejoin, "TeleportInitFailed: " .. tostring(result) .. " " .. tostring(msg), true)
        end)
    end)
end

